<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <ImageView android:layout_width="112dp" android:layout_height="112dp" android:src="@drawable/ic_logo" android:contentDescription="@string/app_name" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/app_name" android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/splash_tagline" android:textColor="@color/white" android:textSize="17sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/student_name" android:textColor="@color/color_accent" android:textSize="15sp" />
</LinearLayout>
