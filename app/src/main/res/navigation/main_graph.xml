<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">
    <fragment android:id="@+id/splashFragment" android:name="com.iuri.task.ui.SplashFragment" android:label="Splash">
        <action android:id="@+id/action_splash_to_authentication" app:destination="@id/authentication" app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
    </fragment>
    <navigation android:id="@+id/authentication" app:startDestination="@id/loginFragment">
        <fragment android:id="@+id/loginFragment" android:name="com.iuri.task.ui.auth.LoginFragment" android:label="Login">
            <action android:id="@+id/action_login_to_register" app:destination="@id/registerFragment" />
            <action android:id="@+id/action_login_to_recover" app:destination="@id/recoverAccountFragment" />
        </fragment>
        <fragment android:id="@+id/registerFragment" android:name="com.iuri.task.ui.auth.RegisterFragment" android:label="Cadastro" />
        <fragment android:id="@+id/recoverAccountFragment" android:name="com.iuri.task.ui.auth.RecoverAccountFragment" android:label="Recuperação" />
        <action android:id="@+id/action_authentication_to_home" app:destination="@id/homeFragment" app:popUpTo="@id/authentication" app:popUpToInclusive="true" />
    </navigation>
    <fragment android:id="@+id/homeFragment" android:name="com.iuri.task.ui.HomeFragment" android:label="Kanban">
        <action android:id="@+id/action_home_to_login" app:destination="@id/authentication" app:popUpTo="@id/homeFragment" app:popUpToInclusive="true" />
    </fragment>
</navigation>
